diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index 62f57eb254321902692550d0a86c24292ef9e87d..e6fff2b4ad7eae6833de37c97c5b1261f7f060be 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -878,6 +878,22 @@ public abstract class PlayerList {
         player.getBukkitEntity().recalculatePermissions(); // CraftBukkit
         this.server.getCommands().sendCommands(player);
         } // Paper - Add sendOpLevel API
+
+        // Velvety start - Enderchest custom rows size
+        if (com.kacimiamine.velvety.config.VelvetyGlobalConfig.enderChestSizeEnabled) {
+            int rows = com.kacimiamine.velvety.config.VelvetyGlobalConfig.enderChestSizeDefaultRows;
+            if (com.kacimiamine.velvety.config.VelvetyGlobalConfig.enderChestSizeUsePermission) {
+                org.bukkit.craftbukkit.entity.CraftHumanEntity playerBukkit = player.getBukkitEntity();
+                for (int r = 6; r >= 1; r--) {
+                    if (playerBukkit.hasPermission("velvety.enderchest.rows." + r)) {
+                        rows = r;
+                        break;
+                    }
+                }
+            }
+            player.enderChestSize = (rows == -1) ? -1 : rows * 9;
+        }
+        // Velvety end - Enderchest custom rows size
     }
 
     // Paper start - whitelist verify event / login event
