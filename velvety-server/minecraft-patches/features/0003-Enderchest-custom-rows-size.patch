+    // Velvety start - Enderchest custom rows size
+    private ChestMenu getEnderChestRowsSize(int containerId, net.minecraft.world.entity.player.Inventory inventory, net.minecraft.world.Container container, Player player) {
+        int rows = com.kacimiamine.velvety.config.VelvetyGlobalConfig.enderChestSizeDefaultRows;
+        if (com.kacimiamine.velvety.config.VelvetyGlobalConfig.enderChestSizeUsePermission) {
+            org.bukkit.craftbukkit.entity.CraftHumanEntity bukkit = player.getBukkitEntity();
+            for (int r = 6; r >= 1; r--) {
+                if (bukkit.hasPermission("velvety.enderchest.rows." + r)) {
+                    rows = r;
+                    break;
+                }
+            }
+        }
+        rows = Math.min(rows, player.getEnderChestInventory().getInitialContainerSize() / 9);
+        player.enderChestSize = (rows == -1) ? -1 : rows * 9;
+        if (rows == -1) return ChestMenu.threeRows(containerId, inventory, container);
+        return new ChestMenu(com.kacimiamine.velvety.block.EnderChestUtil.TYPES[rows - 1], containerId, inventory, container, rows);
+    }
+    // Velvety end - Enderchest custom rows size
+
