     }
 
     // Paper start - Extend dropItem API
@@ -931,6 +933,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         this.locatorBarIcon = input.read("locator_bar_icon", Waypoint.Icon.CODEC).orElseGet(Waypoint.Icon::new);
         this.currentImpulseContextResetGraceTime = input.getIntOr("current_impulse_context_reset_grace_time", 0);
         this.currentImpulseImpactPos = input.read("current_explosion_impact_pos", Vec3.CODEC).orElse(null);
+        this.shouldBurnInDay = input.getBooleanOr("Velvety.ShouldBurnInDay", this.shouldBurnInDay); // Velvety - API for living entity to burn in daylight
     }
 
     @Override
@@ -3826,6 +3829,37 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         if (this.level() instanceof ServerLevel serverLevel && this.isSensitiveToWater() && this.isInWaterOrRain()) {
             this.hurtServer(serverLevel, this.damageSources().drown(), 1.0F);
         }
+
+        // Velvety start - (Moved from Mob) API for living entity to burn in daylight
+        if (this.isAlive() && this.isSunBurnTick() && this.shouldBurnInDay) {
+            EquipmentSlot slot = this.sunProtectionSlot();
+            ItemStack sunBlocker = this.getItemBySlot(slot);
+            if (!sunBlocker.isEmpty()) {
+                if (sunBlocker.isDamageableItem()) {
+                    sunBlocker.hurtAndBreak(this.random.nextInt(2), this, slot);
+                }
+            } else {
+                this.igniteForSeconds(8.0F);
+            }
+        }
+    }
+
+    protected EquipmentSlot sunProtectionSlot() {
+        return EquipmentSlot.HEAD;
+    }
+
+    public boolean isSunBurnTick() {
+        if (!this.level().isClientSide() && this.level().environmentAttributes().getValue(net.minecraft.world.attribute.EnvironmentAttributes.MONSTERS_BURN, this.position())) {
+            float br = this.getLightLevelDependentMagicValue();
+            BlockPos roundedPos = BlockPos.containing(this.getX(), this.getEyeY(), this.getZ());
+            boolean isInNonBurnableBlock = this.isInWaterOrRain() || this.isInPowderSnow || this.wasInPowderSnow;
+            if (br > 0.5F && this.random.nextFloat() * 30.0F < (br - 0.4F) * 2.0F && !isInNonBurnableBlock && this.level().canSeeSky(roundedPos)) {
+                return true;
+            }
+        }
+
+        return false;
+        // Velvety end - (Moved from Mob) API for living entity to burn in daylight
     }
 
     protected void applyInput() {
